{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },

  "P2P": {
    "NodeName": "SERVER-A",
    "DataDirectory": "data",

    "Security": {
      "ApiKey": "CHANGE_ME_generate_with__P2PFileTransfer_--generate-key",
      "ClockSkewSeconds": 300,
      "RequireHttps": false,
      "AcceptOnlyKnownPeers": true,
      "AllowedIPs": [],
      "MaxFailedAttempts": 5,
      "FailedAttemptWindowMinutes": 10,
      "BanMinutes": 30,
      "RateLimitPerMinute": 3000
    },

    "Receiver": {
      "Enabled": true,
      "Destinations": {
        "backups": "D:\\P2P\\Incoming\\Backups"
      },
      "SeparateFolderPerSender": true,
      "AllowedExtensions": [ ".bak", ".trn", ".dif", ".sql", ".dump", ".backup", ".gz", ".zip", ".7z", ".rar", ".tar" ],
      "MaxFileSizeMB": 0,
      "MaxChunkSizeMB": 16,
      "MinFreeDiskSpaceMB": 1024,
      "OverwriteExisting": false,
      "IncompleteTransferExpiryHours": 48
    },

    "Sender": {
      "ChunkSizeMB": 4,
      "MaxRetries": 5,
      "RetryDelaySeconds": 30,
      "RequestTimeoutSeconds": 600,
      "MinFileAgeMinutes": 5,
      "CatchUpMinutes": 120
    },

    "Peers": [
      {
        "Name": "SERVER-B",
        "BaseUrl": "http://192.168.1.20:5080/",
        "CertificateThumbprint": "",
        "AllowInvalidCertificate": false
      }
    ],

    "Jobs": [
      {
        "Name": "db-backup",
        "Enabled": true,
        "SourceDirectory": "D:\\Backup\\SQL",
        "FilePatterns": [ "*.bak", "*.trn" ],
        "IncludeSubdirectories": false,
        "TargetPeers": [ "SERVER-B" ],
        "RemoteDestination": "backups",
        "Times": [ "01:30" ],
        "Days": [],
        "MaxFileAgeDays": 7
      }
    ],

    "FileLog": {
      "Enabled": true,
      "Directory": "logs",
      "RetentionDays": 30
    }
  }
}
